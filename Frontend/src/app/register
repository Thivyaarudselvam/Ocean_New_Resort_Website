/* Register Page Styles */

.page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #0a1628 0%, #1a3a5c 50%, #0f2744 100%);
  padding: 20px;
  position: relative;
}

.backLink {
  position: absolute;
  top: 24px;
  left: 24px;
  display: flex;
  align-items: center;
  gap: 8px;
  color: #94a3b8;
  font-weight: 500;
  transition: color 0.2s;
}

.backLink:hover {
  color: #14b8a6;
}

.container {
  width: 100%;
  max-width: 480px;
}

.card {
  background: #1e293b;
  border: 1px solid #334155;
  border-radius: 16px;
  padding: 40px;
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
}

.header {
  text-align: center;
  margin-bottom: 32px;
}

.logo {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  margin-bottom: 24px;
}

.logoIcon {
  font-size: 2rem;
}

.logoText {
  font-size: 1.25rem;
  font-weight: 700;
  color: #f1f5f9;
}

.title {
  font-size: 1.75rem;
  font-weight: 700;
  color: #f1f5f9;
  margin-bottom: 8px;
}

.subtitle {
  color: #94a3b8;
  font-size: 0.95rem;
}

.form {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}

.formGroup {
  display: flex;
  flex-direction: column;
}

.label {
  font-weight: 500;
  color: #f1f5f9;
  margin-bottom: 8px;
  font-size: 0.95rem;
}

.input {
  padding: 14px 16px;
  font-size: 1rem;
  color: #f1f5f9;
  background: #0f2744;
  border: 1px solid #334155;
  border-radius: 8px;
  transition: all 0.2s;
}

.input:focus {
  outline: none;
  border-color: #14b8a6;
  box-shadow: 0 0 0 3px rgba(20, 184, 166, 0.2);
}

.input::placeholder {
  color: #64748b;
}

.inputError {
  border-color: #ef4444;
}

.inputError:focus {
  border-color: #ef4444;
  box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.2);
}

.error {
  color: #ef4444;
  font-size: 0.85rem;
  margin-top: 6px;
}

.submitBtn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 14px 24px;
  font-size: 1rem;
  font-weight: 600;
  color: white;
  background: linear-gradient(135deg, #14b8a6 0%, #0ea5e9 100%);
  border: none;
  border-radius: 8px;
  cursor: pointer;
  transition: all 0.2s;
  margin-top: 8px;
}

.submitBtn:hover:not(:disabled) {
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(20, 184, 166, 0.4);
}

.submitBtn:disabled {
  opacity: 0.7;
  cursor: not-allowed;
}

.spinner {
  width: 18px;
  height: 18px;
  border: 2px solid rgba(255, 255, 255, 0.3);
  border-top-color: white;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.footer {
  text-align: center;
  margin-top: 24px;
  padding-top: 24px;
  border-top: 1px solid #334155;
}

.footer p {
  color: #94a3b8;
  font-size: 0.95rem;
}

.link {
  color: #14b8a6;
  font-weight: 500;
  transition: color 0.2s;
}

.link:hover {
  color: #2dd4bf;
}

@media (max-width: 560px) {
  .card {
    padding: 24px;
  }
  
  .title {
    font-size: 1.5rem;
  }
  
  .row {
    grid-template-columns: 1fr;
  }
  
  .backLink {
    top: 16px;
    left: 16px;
    font-size: 0.9rem;
  }
}